<style>
  .hero-images {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin: 2rem 0;
  }

  .intro {
    margin: 2rem 0;
  }

  blockquote {
    font-style: italic;
    padding: 1rem;
    border-left: 3px solid var(--color-accent);
    margin: 1rem 0;
  }

  .blog-links {
    margin: 2rem 0;
  }

  .blog-links img {
    max-width: 200px;
    margin: 1rem 0;
  }
</style>
